{
  "name": "noorshine-wordpress-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NoorShine WooCommerce catalog automation and WordPress storefront source",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "categories:sync": "node scripts/sync-categories.mjs",
    "products:list": "node scripts/list-products.mjs",
    "products:import": "node scripts/import-products.mjs",
    "products:export": "node scripts/export-products.mjs",
    "products:update": "node scripts/update-product.mjs",
    "products:variations": "node scripts/manage-variations.mjs",
    "pages:sync": "node scripts/sync-pages.mjs",
    "store:configure": "node scripts/configure-store.mjs",
    "images:upload": "node scripts/upload-image.mjs",
    "inventory:validate": "node scripts/validate-inventory.mjs",
    "check": "node scripts/validate-catalog.mjs && find wp-content -name '*.php' -print0 | xargs -0 -n1 php -l && find scripts tests wp-content -type f \\( -name '*.mjs' -o -name '*.js' \\) -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

